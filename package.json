{
  "name": "cybeck-security-systems",
  "version": "0.1.8",
  "description": "Cybeck Security Systems — personal desktop security command centre",
  "main": "main.js",
  "author": "Cybeck Security Systems",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --win",
    "publish": "electron-builder --win --publish always --config.forceCodeSigning=true"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.cybeck.securitysystems",
    "productName": "Cybeck Security Systems",
    "files": [
      "**/*",
      "!back-up/**",
      "!tests/**",
      "!tmp/**",
      "!낈팱ǆ/**",
      "!RELEASE_NOTES_*.md"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cybeck Security Systems"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Cybeck-SS",
        "repo": "Cybeck-Security-Systems"
      }
    ]
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  }
}
